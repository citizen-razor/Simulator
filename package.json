{
  "name": "simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build interactive training simulations from screenshots, code, docs and video.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && cross-env NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
