# Copy this file to .env and fill in your key. .env is git-ignored.
# Get a key at https://platform.claude.com/ (Settings → API keys).
ANTHROPIC_API_KEY=

# Optional overrides
# SIM_MODEL=claude-opus-5-5
# PORT=8787
# DATA_DIR=data

# Admin PIN: unlocks editing the topic/tag and grading libraries and trainer marking.
# Leave empty to let anyone edit (fine for a single person on their own computer).
ADMIN_PIN=
